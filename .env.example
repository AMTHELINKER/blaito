# ─── Laito API ───
NODE_ENV=development
PORT=3000
# URL publique du front (CORS, liens dans les e-mails)
WEB_ORIGIN=http://localhost:5173
# URL publique de l'API (pour les fichiers téléversés en local)
API_PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgres://laito:laito@localhost:5433/laito
# Facultatif. Sans Redis : e-mails envoyés directement, temps réel en mémoire (une seule instance).
REDIS_URL=redis://localhost:6380

# Facultatif : dossier du front construit, servi par l'API sur le même domaine (déploiement à service unique).
WEB_DIR=

# Secrets — à changer en production (openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# E-mails : sans SMTP_HOST, les e-mails sont affichés dans les logs de l'API
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Laito <no-reply@laito.app>"

# Stockage des images : local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=laito
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publique (CDN) devant le bucket
S3_PUBLIC_URL=
